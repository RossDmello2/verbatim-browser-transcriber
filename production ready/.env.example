# Verbatim - Environment Variables
#
# Verbatim is a static browser app and does not read server-side environment
# variables at runtime.
#
# Provider API keys are entered by the user in the application UI. If saved,
# they are stored in browser storage on that user's machine.
#
# Do not put real Groq, OpenAI, Gemini, or other provider keys in this file.

# Runtime provider keys
# Required: No. Default: empty.
# Configure Groq/OpenAI-compatible and Gemini keys inside the app UI.
# Safe placeholder only:
VERBATIM_PROVIDER_KEYS_CONFIGURED_IN_UI=true

# Static hosting
# Required: No. Default: static host root.
# Set by your hosting platform if you need to document the deployed app URL.
VERBATIM_PUBLIC_SITE_URL=https://example.com
